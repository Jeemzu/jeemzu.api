@baseUrl = http://localhost:5050
@accessToken = replace-with-local-access-token

### Propose the concept checkpoint (503 if OpenAI:GddApiKey is missing; explicit approval happens in the editor)
POST {{baseUrl}}/api/gdd-assistant
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "mode": "scratch",
  "checkpoint": "concept",
  "prompt": "Help design a small exploration game about restoring an abandoned island.",
  "document": "# Island game",
  "history": [],
  "references": [
    { "name": "Design constraints", "text": "Solo developer; one island; Windows first.", "url": "", "imageBase64": "" }
  ]
}

### Fill missing gameplay details in an existing GDD (any checkpoint may be selected)
POST {{baseUrl}}/api/gdd-assistant
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "mode": "fill",
  "checkpoint": "gameplay",
  "prompt": "Help fill the missing supporting systems without changing my core loop.",
  "document": "{\"currentGdd\":\"# Island game\\n\\n## Core gameplay\\n\\n### Core loop\\n\\nExplore, restore habitats, unlock paths.\",\"missingDetails\":[{\"section\":\"Core gameplay\",\"headings\":[\"Supporting systems\"]}],\"pendingProposal\":null}",
  "history": [],
  "references": []
}

### Invalid checkpoint returns 400 without calling the model
POST {{baseUrl}}/api/gdd-assistant
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "checkpoint": "unsupported",
  "prompt": "Draft the game",
  "document": "# Game",
  "history": [],
  "references": []
}

### Guests receive 401
POST {{baseUrl}}/api/gdd-assistant
Content-Type: application/json

{
  "checkpoint": "concept",
  "prompt": "Draft the game",
  "document": "# Game",
  "history": [],
  "references": []
}
